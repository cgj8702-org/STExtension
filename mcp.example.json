# RemoteMCP — Lovense MCP server config examples
# Pick ONE of stdio / sse / streamable-http depending on your MCP host.

# --- Claude Desktop / stdio (default) ---
# {
#   "mcpServers": {
#     "lovense": {
#       "command": "/home/carly/SillyTavern/public/scripts/extensions/third-party/STExtension/.venv/bin/python",
#       "args": [
#         "/home/carly/SillyTavern/public/scripts/extensions/third-party/STExtension/RemoteMCP.py",
#         "CONNECTION_MODE=local",
#         "GAME_MODE_IP=192.168.1.100",
#         "GAME_MODE_PORT=30010"
#       ]
#     }
#   }
# }

# --- Mock mode (no toy needed, for testing) ---
# {
#   "mcpServers": {
