# }

# --- Server cloud mode ---
# {
#   "mcpServers": {
#     "lovense-server": {
#       "command": "/home/carly/SillyTavern/public/scripts/extensions/third-party/STExtension/.venv/bin/python",
#       "args": [
#         "/home/carly/SillyTavern/public/scripts/extensions/third-party/STExtension/RemoteMCP.py",
#         "CONNECTION_MODE=server",
#         "DEVELOPER_TOKEN=YOUR_TOKEN",
#         "USER_ID=YOUR_UID"
#       ]
#     }
#   }
# }

# --- SSE transport (hosts that need HTTP) ---
# Run: .venv/bin/python RemoteMCP.py CONNECTION_MODE=mock MCP_TRANSPORT=sse MCP_PORT=8899
# Then point your client at http://127.0.0.1:8899/sse

# --- Streamable HTTP transport (modern default) ---
# Run: .venv/bin/python RemoteMCP.py CONNECTION_MODE=mock MCP_TRANSPORT=streamable-http MCP_PORT=8899
# Then point your client at http://127.0.0.1:8899/mcp
